{
  "expo": {
    "name": "Salah Times",
    "slug": "SalahTimesBotswana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#102540",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-dark.png",
      "resizeMode": "cover",
      "backgroundColor": "#102540"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zaihdo.SalahTimesBotswana",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#102540"
      },
      "package": "com.zaihdo.SalahTimesBotswana"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "59b08a14-b8bd-4255-a84b-5407eea13cf1"
      }
    }
  }
}
